{# templates/admin/dashboard.html.twig #}

{% extends 'base.html.twig' %}

{% block title %}Tableau de Bord - Locapharma
{% endblock %}

{% block stylesheets %}
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet">
	<style>
		body {
			margin: 0;
			padding: 0;
			font-family: Arial, sans-serif;
			background-color: #f8f9fa; /* Couleur de fond par défaut */
		}

		.background-overlay::before {
			content: '';
			position: absolute;
			top: 0;
			left: 0;
			width: 100%;
			height: 100%;
			background-image: url("{{ asset('images/7074751-pharmacie-logo-medical-green-cross-vector-icon-vectoriel.jpg') }}");
			background-size: cover;
			background-position: center;
			background-attachment: fixed;
			opacity: 0.3; /* Ajustez cette valeur pour changer l'opacité */
			filter: blur(6px); /* Applique un effet de flou */
			z-index: -2;
		}

		.background-overlay {
			position: fixed;
			top: 0;
			left: 0;
			width: 100%;
			height: 100%;
			z-index: -1;
		}

		.dashboard-container {
			margin-top: 50px;
			max-width: 900px;
			margin-left: auto;
			margin-right: auto;
			text-align: center;
			position: relative;
			z-index: 1;
		}

		.dashboard-card {
			margin: 20px 0;
		}

		.btn {
			margin: 10px;
		}
		.nombre-medic {
			font-family: "Comic Sans MS", cursive, sans-serif;
			text-shadow: 0 0 10px rgba(0, 0, 0, 0.532);
			font-size: 40px;
		}
		.mb-4 {
			font-family: "Chalkduster", fantasy;
		}
	</style>
{% endblock %}

{% block body %}
	<div class="background-overlay"></div>
	<nav class="navbar navbar-expand-lg navbar-light bg-light">
		<div class="container-fluid">
			<a class="navbar-brand" href="#"></a>
			<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
				<span class="navbar-toggler-icon"></span>
			</button>

			<div class="col-md-4 text-center text-md-end" style="margin-left: 59%; position: absolute;">
				<a href="" data-bs-toggle="modal" data-bs-target="#notificationModal">
					<div class="notifications position-relative">
						<i class="bi bi-bell"></i>
						<svg class="notificone" style="color: #0839CF;" xmlns="http://www.w3.org/2000/svg" width="30" height="30" fill="currentColor" class="bi bi-bell-fill" viewbox="0 0 16 16">
							<path d="M8 16a2 2 0 0 0 2-2H6a2 2 0 0 0 2 2m.995-14.901a1 1 0 1 0-1.99 0A5 5 0 0 0 3 6c0 1.098-.5 6-2 7h14c-1.5-1-2-5.902-2-7 0-2.42-1.72-4.44-4.005-4.901"/>
						</svg>


						<span class="notification-badge">1</span>

					</div>
				</a>
			</div>
			<div class="modal fade" id="notificationModal" tabindex="-1" aria-labelledby="notificationModalLabel" aria-hidden="true">
				<div class="modal-dialog">
					<div class="modal-content">
						<div class="modal-header">
							<h5 class="modal-title" id="notificationModalLabel" style="font-size: 15px;">Tous les notification</h5>
							<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
						</div>

						<div
							class="modal-body">
							{# <p class="modal-title ">66666666666</p> #}
							<p class="notification-body">Vous-avez une nouvelle commande !!</p>
							<p class="notification-date" style="float:right;margin-top:25px;">
								Il y'a 30mn...</p>
						</div>


						<div class="modal-footer">
							<button type="button" class="btn btn-primary" data-bs-dismiss="modal">Quitter</button>
						</div>
					</div>
				</div>
			</div>


			<div class="collapse navbar-collapse" id="navbarNav">

				<ul class="navbar-nav ms-auto">
					<li class="nav-item dropdown">
						<a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
							Profil
						</a>
						<ul class="dropdown-menu dropdown-menu-end" aria-labelledby="navbarDropdown" style="border-radius: 20px;">
							<li>
								<a class="dropdown-item" href="#">
									{{ pharmacie.nomPharma }}</a>
							</li>
							<li>
								<a class="dropdown-item" href="#">{{ pharmacie.email }}</a>
							</li>
							<li><hr class="dropdown-divider"></li>
							<li>
								<a class="dropdown-item text-danger" href="{{path('app_logout')}}">Déconnexion</a>
							</li>
						</ul>
					</li>
				</ul>
			</div>
		</div>

	</nav>
	<div class="container dashboard-container">
		<h1 class="mb-4">Tableau de Bord Pharmacien</h1>


<div class="row">
				<div class="d-flex justify-content-between">
					<div class="card dashboard-card" style="background: rgb(188, 238, 255); border-radius: 20px; flex: 1; margin-right: 10px;">
						<div class="card-body">
							<h5 class="card-title">Total Médicaments</h5>
							<b>
								<strong>
									<h2 class="nombre-pharmacies">__ {{ pharmacie.medicaments|length }} __</h2>
								</strong>
							</b>
						</div>
					</div>
					<div class="card dashboard-card" style="background: rgb(178, 218, 231); border-radius: 20px; flex: 1; margin-right: 10px;">
						<div class="card-body">
							<h5 class="card-title">Total Commandes</h5>
							<b>
								<strong>
									<h2 class="nombre-pharmacies">__ 1 __</h2>
								</strong>
							</b>
						</div>
					</div>
					
				</div>
			</div>


		<div class="row">
			<div class="col-md-4">
				<div class="card dashboard-card" style="border-radius: 20px; box-shadow: 0 0 10px rgba(0, 0, 0, 0.532);">
					<div class="card-body">
						<h5 class="card-title">Ajouter un Médicament</h5>
						<p class="card-text">Accédez à la page pour ajouter de nouveaux médicaments.</p>
						<a href="{{ path('app_addmedicament') }}" class="btn btn-primary" style="border-radius: 20px; background: #0839CF;">Ajouter Médicament</a>
					</div>
				</div>
			</div>
			<div class="col-md-4">
				<div class="card dashboard-card" style="border-radius: 20px; box-shadow: 0 0 10px rgba(0, 0, 0, 0.532);">
					<div class="card-body">
						<h5 class="card-title">Gestion des Horaires</h5>
						<p class="card-text">Accédez à la page pour gérer les horaires d'ouverture et de fermeture.</p>
						<a href="{{ path('app_addheur') }}" class="btn btn-primary" style="border-radius: 20px; background: #0839CF;">Gérer Horaires</a>
					</div>
				</div>
			</div>
			<div class="col-md-4">
				<div class="card dashboard-card" style="border-radius: 20px; box-shadow: 0 0 10px rgba(0, 0, 0, 0.532);">
					<div class="card-body">
						<h5 class="card-title">Modifier Médicament</h5>
						<p class="card-text">Accédez à la page pour modifier les informations sur les médicaments.</p>
						<a href="{{ path('app_listemedic') }}" class="btn btn-primary" style="border-radius: 20px; background: #0839CF;">Modifier Médicament</a>
					</div>
				</div>
			</div>
			<div class="col-md-4">
				<div class="card dashboard-card" style="border-radius: 20px; box-shadow: 0 0 10px rgba(0, 0, 0, 0.532);">
					
				</div>
			</div>
			<div class="col-md-4">
				<div class="card dashboard-card" style="border-radius: 20px; box-shadow: 0 0 10px rgba(0, 0, 0, 0.532);">
					<div class="card-body">
						<h5 class="card-title">Géstion de commandes</h5>
						
						<a href="{{ path('app_traitement_commande') }}" class="btn btn-primary" style="border-radius: 20px; background: #0839CF;">Gérer les commandes</a>
					</div>
				</div>
			</div>
			<div class="col-md-4">
				<div class="card dashboard-card" style="border-radius: 20px; box-shadow: 0 0 10px rgba(0, 0, 0, 0.532);">
					
				</div>
			</div>
		</div>
		<script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.9.2/dist/umd/popper.min.js"></script>
		<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.min.js"></script>
	</div>
{% endblock %}
