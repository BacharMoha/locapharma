											<h3 class="card-title text-center mb-4">Envoyez-nous votre ordonnance
												<img class="imgl" src="{{ asset('images/logoloca-removebg-preview.png') }}" id="locfr" width="100" height="100" alt="Pharmacy Icon" style="opacity: 50%; margin-left: 5%; position: absolute; margin-top: -5%;"></h3>

											<form
